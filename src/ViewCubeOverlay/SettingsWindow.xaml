<Window x:Class="ViewCubeOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ViewCubeOverlay"
        Title="Настройки видового куба"
        Width="500"
        Height="680"
        MinWidth="390"
        MinHeight="480"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#263548"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263548"/>
      <Setter Property="BorderBrush" Value="#D5DEE9"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#263548"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="17,9"/><Setter Property="FontSize" Value="13"/></Style>
  </Window.Resources>
  <DockPanel Margin="20,16,20,16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="Видовой куб" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Настройте удобный вид для работы в Renga" Foreground="#63758A" Margin="0,3,0,0"/>
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock Text="Изменения применяются сразу" Foreground="#63758A" VerticalAlignment="Center"/>
      <Button x:Name="CloseButton" Content="Закрыть" Width="104" Height="34" HorizontalAlignment="Right"
              IsDefault="True" Click="CloseButton_Click"/>
    </Grid>
    <TabControl Background="White" BorderBrush="#DDE4ED">
      <TabItem Header="Настройки">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,18,18,16">
        <TextBlock Text="Готовые стили" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <UniformGrid Columns="2" Margin="0,0,0,10">
          <Button x:Name="PresetClassic" Content="Классика" Margin="0,0,4,4" Height="26"
                  Click="PresetClassic_Click" ToolTip="Steel-blue / indian-red / gainsboro"/>
          <Button x:Name="PresetNeutral" Content="Нейтральный" Margin="4,0,0,4" Height="26"
                  Click="PresetNeutral_Click" ToolTip="Серый CAD"/>
          <Button x:Name="PresetContrast" Content="Контраст" Margin="0,4,4,0" Height="26"
                  Click="PresetContrast_Click" ToolTip="Высокий контраст"/>
          <Button x:Name="PresetRenga" Content="Renga" Margin="4,4,0,0" Height="26"
                  Click="PresetRenga_Click"
                  ToolTip="Навигационный куб Renga: фаски, светло-серый, подписи без плашки"/>
        </UniformGrid>

        <Separator Margin="0,8,0,14"/><TextBlock Text="Цвета граней" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Сверху" VerticalAlignment="Center"/>
          <local:ColorField x:Name="FaceTop" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="1" Text="Снизу" VerticalAlignment="Center"/>
          <local:ColorField x:Name="FaceBottom" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="2" Text="Спереди" VerticalAlignment="Center"/>
          <local:ColorField x:Name="FaceFront" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="3" Text="Сзади" VerticalAlignment="Center"/>
          <local:ColorField x:Name="FaceBack" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="4" Text="Слева" VerticalAlignment="Center"/>
          <local:ColorField x:Name="FaceLeft" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="5" Text="Справа" VerticalAlignment="Center"/>
          <local:ColorField x:Name="FaceRight" Grid.Row="5" Grid.Column="1" Margin="0,2"/>
        </Grid>

        <Separator Margin="0,8,0,14"/><TextBlock Text="Подписи" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Текст" VerticalAlignment="Center"/>
          <local:ColorField x:Name="LabelText" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="1" Text="Плашка" VerticalAlignment="Center"/>
          <local:ColorField x:Name="LabelPill" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
        </Grid>
        <CheckBox x:Name="ShowLabels" Content="Показывать подписи на гранях"
                  Margin="0,0,0,10" Click="Option_Changed"/>

        <Separator Margin="0,8,0,14"/><TextBlock Text="Подсветка куба" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Маркеры" VerticalAlignment="Center"
                     ToolTip="Цвет и прозрачность рёбер и углов"/>
          <local:ColorField x:Name="HotspotColor" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="1" Text="Наведение" VerticalAlignment="Center"/>
          <local:ColorField x:Name="HoverColor" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
          <TextBlock Grid.Row="2" Text="Активная" VerticalAlignment="Center"
                     ToolTip="Подсветка ортогональной грани"/>
          <local:ColorField x:Name="ActiveFaceColor" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
        </Grid>

        <Separator Margin="0,8,0,14"/><TextBlock Text="Размер и окно" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <CheckBox x:Name="CompactChrome" Content="Компактный заголовок"
                  Margin="0,0,0,8" Click="Option_Changed"/>
        <DockPanel Margin="0,0,0,4">
          <TextBlock DockPanel.Dock="Left" Text="Масштаб" VerticalAlignment="Center" Width="88"/>
          <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                     VerticalAlignment="Center"/>
          <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.8" TickFrequency="0.1"
                  IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged"/>
        </DockPanel>
        <TextBlock FontSize="10" Foreground="#666"
                   Text="Колёсико мыши над кубом или кнопки +/− рядом с Home."
                   TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="О плагине">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,22,22,24">
            <TextBlock Text="Видовой куб для Renga" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Навигация по 3D-модели" Foreground="#63758A" Margin="0,5,0,18"/>
            <TextBlock Text="Плавающий куб помогает управлять направлением камеры: выберите грань, ребро или угол, чтобы повернуть 3D-вид. Кнопка «Домой» возвращает изометрический вид." TextWrapping="Wrap" LineHeight="21"/>
            <Separator Margin="0,20,0,18"/>
            <TextBlock Text="РАЗРАБОТЧИК" FontSize="11" FontWeight="SemiBold" Foreground="#63758A"/>
            <TextBlock Text="Гаряев Иван Иванович" FontSize="14" Margin="0,5,0,18"/>
            <TextBlock Text="ВЕРСИЯ" FontSize="11" FontWeight="SemiBold" Foreground="#63758A"/>
            <TextBlock x:Name="VersionText" FontSize="14" Margin="0,5,0,18"/>
            <TextBlock Text="РЕПОЗИТОРИЙ ПРОЕКТА" FontSize="11" FontWeight="SemiBold" Foreground="#63758A"/>
            <TextBlock Margin="0,5,0,4" TextWrapping="Wrap">
              <Hyperlink NavigateUri="https://github.com/Garyaev-dev/Renga-View-Cube" RequestNavigate="Repository_RequestNavigate">github.com/Garyaev-dev/Renga-View-Cube</Hyperlink>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
