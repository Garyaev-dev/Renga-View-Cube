<Window x:Class="ViewCubeOverlay.ViewCubeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ViewCubeOverlay"
        Title="Видовой куб"
        Width="196" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="False"
        Background="#01000000"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="Настройки…" Click="SettingsMenu_Click"/>
      <Separator/>
      <MenuItem Header="Крупнее" Click="ScaleUpMenu_Click"/>
      <MenuItem Header="Мельче" Click="ScaleDownMenu_Click"/>
      <Separator/>
      <MenuItem Header="Классика" Click="PresetClassicMenu_Click"/>
      <MenuItem Header="Нейтральный" Click="PresetNeutralMenu_Click"/>
      <MenuItem Header="Контраст" Click="PresetContrastMenu_Click"/>
      <MenuItem Header="Renga" Click="PresetRengaMenu_Click" ToolTip="Навигационный куб"/>
      <Separator/>
      <MenuItem x:Name="ShowLabelsMenu" Header="Показывать подписи" IsCheckable="True" Click="ShowLabelsMenu_Click"/>
      <MenuItem x:Name="CompactChromeMenu" Header="Компактный заголовок" IsCheckable="True" Click="CompactChromeMenu_Click"/>
    </ContextMenu>
  </Window.ContextMenu>
  <Grid Background="#01000000">
    <local:ViewCubeControl x:Name="CubeControl" Margin="0,24,0,0" />

    <Border x:Name="TitleBar"
            VerticalAlignment="Top"
            Height="24"
            Background="#90000000"
            Opacity="0"
            CornerRadius="4,4,0,0"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <TextBlock x:Name="TitleText" Text="Видовой куб" ToolTip="Разработчик: Гаряев Иван Иванович"
                   Foreground="White" VerticalAlignment="Center"
                   Margin="8,0,0,0" FontSize="11" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
          <Button x:Name="SettingsButton" Content="⚙" Width="20" Height="20" Margin="0,0,2,0"
                  Background="Transparent" Foreground="White" BorderThickness="0"
                  ToolTip="Настройки цвета и вида"
                  Click="SettingsButton_Click" Cursor="Hand" />
          <Button Content="⟲" Width="20" Height="20" Margin="0,0,2,0"
                  Background="Transparent" Foreground="White" BorderThickness="0"
                  ToolTip="Сбросить позицию окна"
                  Click="ResetDockButton_Click" Cursor="Hand" />
          <Button Content="✕" Width="20" Height="20"
                  Background="Transparent" Foreground="White" BorderThickness="0"
                  Click="CloseButton_Click" Cursor="Hand" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
