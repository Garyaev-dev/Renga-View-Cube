<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputPath>..\..\bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <RootNamespace>ViewCubeOverlay</RootNamespace>
    <AssemblyName>ViewCubeOverlay</AssemblyName>
    <Authors>Гаряев Иван Иванович</Authors>
    <Company>Гаряев Иван Иванович</Company>
    <Copyright>Copyright © Гаряев Иван Иванович</Copyright>
    <Description>Видовой куб — плавающее окно с 3D-кубом поверх интерфейса Renga. Разработчик: Гаряев Иван Иванович.</Description>
    <Version>1.5.2</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>TRACE</DefineConstants>
    <!-- NuGet-пакет Obfuscar задаёт $(Obfuscar). Без сети ищем кэш / tools. -->
    <Obfuscar Condition="'$(Obfuscar)' == '' And Exists('$(NuGetPackageRoot)obfuscar\2.2.49\tools\Obfuscar.Console.exe')">$(NuGetPackageRoot)obfuscar\2.2.49\tools\Obfuscar.Console.exe</Obfuscar>
    <Obfuscar Condition="'$(Obfuscar)' == '' And Exists('$(MSBuildThisFileDirectory)tools\Obfuscar.Console.exe')">$(MSBuildThisFileDirectory)tools\Obfuscar.Console.exe</Obfuscar>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ViewCubeOverlay.rndesc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png" Condition="Exists('icon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Obfuscar.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.49">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Renga.NET8.PluginUtility">
      <HintPath>$(RengaSdkLib)Renga.NET8.PluginUtility.dll</HintPath>
    </Reference>
    <COMFileReference Include="$(RengaSdkLib)RengaCOMAPI.tlb" />
  </ItemGroup>

  <Target Name="PackReleasePlugin" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ObfDll>$(OutputPath)obfuscated\ViewCubeOverlay.dll</_ObfDll>
      <_DeployDir Condition="'$(RengaPluginDeployDir)' != ''">$([System.IO.Path]::GetFullPath('$(RengaPluginDeployDir)'))</_DeployDir>
    </PropertyGroup>

    <MakeDir Directories="$(OutputPath)obfuscated" Condition="Exists('$(Obfuscar)')" />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(MSBuildThisFileDirectory)Obfuscar.xml&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true"
          Condition="Exists('$(Obfuscar)')">
      <Output TaskParameter="ExitCode" PropertyName="ObfuscarExitCode" />
    </Exec>
    <Warning Text="Obfuscar executable not found; shipping optimized Release without obfuscation."
             Condition="!Exists('$(Obfuscar)')" />
    <Copy SourceFiles="$(_ObfDll)"
          DestinationFiles="$(OutputPath)ViewCubeOverlay.dll"
          Condition="'$(ObfuscarExitCode)' == '0' And Exists('$(_ObfDll)')"
          OverwriteReadOnlyFiles="true" />
    <Warning Text="Obfuscar failed (exit $(ObfuscarExitCode)). Shipping optimized Release without obfuscation."
             Condition="'$(ObfuscarExitCode)' != '' And '$(ObfuscarExitCode)' != '0'" />
    <Message Text="Obfuscar succeeded: replaced ViewCubeOverlay.dll with obfuscated build."
             Importance="high"
             Condition="'$(ObfuscarExitCode)' == '0' And Exists('$(_ObfDll)')" />

    <ItemGroup Condition="'$(_DeployDir)' != ''">
      <_DeployFiles Include="$(OutputPath)ViewCubeOverlay.dll" />
      <_DeployFiles Include="$(OutputPath)ViewCubeOverlay.deps.json" />
      <_DeployFiles Include="$(OutputPath)ViewCubeOverlay.rndesc" />
      <_DeployFiles Include="$(OutputPath)icon.png" Condition="Exists('$(OutputPath)icon.png')" />
      <_DeployFiles Include="$(OutputPath)Renga.NET8.PluginUtility.dll" Condition="Exists('$(OutputPath)Renga.NET8.PluginUtility.dll')" />
      <_DeployFiles Include="$(OutputPath)Interop.Renga.dll" Condition="Exists('$(OutputPath)Interop.Renga.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(_DeployDir)" Condition="'$(_DeployDir)' != ''" />
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(_DeployDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true"
          Condition="'$(_DeployDir)' != ''" />
    <Delete Files="$(_DeployDir)ViewCubeOverlay.pdb"
            Condition="'$(_DeployDir)' != '' And Exists('$(_DeployDir)ViewCubeOverlay.pdb')" />
    <Delete Files="$(_DeployDir)PLAN.md"
            Condition="'$(_DeployDir)' != '' And Exists('$(_DeployDir)PLAN.md')" />
    <Delete Files="$(_DeployDir)Obfuscar.xml"
            Condition="'$(_DeployDir)' != '' And Exists('$(_DeployDir)Obfuscar.xml')" />
    <Message Text="Deployed Release plugin to $(_DeployDir)" Importance="high"
             Condition="'$(_DeployDir)' != ''" />
  </Target>

</Project>
