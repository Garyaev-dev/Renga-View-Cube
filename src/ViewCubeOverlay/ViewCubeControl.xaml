<UserControl x:Class="ViewCubeOverlay.ViewCubeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             PreviewMouseWheel="Root_PreviewMouseWheel">
  <Grid x:Name="Root"
        Background="#01000000"
        MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp"
        MouseLeave="Root_MouseLeave">
    <!-- Живой GPU Viewport3D. Белый квад в AllowsTransparency бывает только
         пока тащат заголовок окна — тогда Viewport прячется (Hidden). -->
    <Viewport3D x:Name="Viewport"
                Margin="10"
                IsHitTestVisible="False"
                ClipToBounds="True" />

    <StackPanel HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,2,4,0">
      <Button x:Name="ScaleUpButton"
              Width="22"
              Height="18"
              Content="+"
              FontSize="12"
              FontWeight="Bold"
              Padding="0"
              Background="#CC1A1A1A"
              Foreground="White"
              BorderBrush="#55FFFFFF"
              BorderThickness="1"
              Cursor="Hand"
              ToolTip="Увеличить куб (колёсико мыши)"
              Click="ScaleUpButton_Click"/>
      <Button x:Name="HomeButton"
              Width="22"
              Height="22"
              Margin="0,2,0,2"
              Content="⌂"
              FontSize="13"
              Padding="0"
              Background="#CC1A1A1A"
              Foreground="White"
              BorderBrush="#55FFFFFF"
              BorderThickness="1"
              Cursor="Hand"
              ToolTip="Домой (изометрия сверху-спереди-справа)"
              Click="HomeButton_Click"/>
      <Button x:Name="ScaleDownButton"
              Width="22"
              Height="18"
              Content="−"
              FontSize="12"
              FontWeight="Bold"
              Padding="0"
              Background="#CC1A1A1A"
              Foreground="White"
              BorderBrush="#55FFFFFF"
              BorderThickness="1"
              Cursor="Hand"
              ToolTip="Уменьшить куб (колёсико мыши)"
              Click="ScaleDownButton_Click"/>
    </StackPanel>
  </Grid>
</UserControl>
