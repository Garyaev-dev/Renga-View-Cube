<UserControl x:Class="ViewCubeOverlay.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             MinWidth="120">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBox x:Name="HexBox"
             FontFamily="Consolas"
             FontSize="11"
             Height="22"
             VerticalContentAlignment="Center"
             LostFocus="HexBox_LostFocus"
             KeyDown="HexBox_KeyDown"/>
    <Border x:Name="Swatch"
            Grid.Column="1"
            Width="26"
            Height="22"
            Margin="4,0,0,0"
            BorderBrush="#88000000"
            BorderThickness="1"
            Cursor="Hand"
            MouseLeftButtonDown="Swatch_MouseLeftButtonDown"
            ToolTip="Выбрать цвет"/>
    <!-- StaysOpen=True: не закрывать по MouseLeave / потере capture при перетаскивании слайдеров. -->
    <Popup x:Name="Picker"
           PlacementTarget="{Binding ElementName=Swatch}"
           Placement="Bottom"
           VerticalOffset="2"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None"
           Focusable="False">
      <Border x:Name="PickerPanel"
              Background="#F4F4F4"
              BorderBrush="#888"
              BorderThickness="1"
              Padding="8"
              Width="220"
              Focusable="True"
              FocusVisualStyle="{x:Null}">
        <StackPanel>
          <TextBlock x:Name="RgbLabel" FontSize="11" Margin="0,0,0,4"/>
          <Slider x:Name="SliderR" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="Slider_ValueChanged"/>
          <Slider x:Name="SliderG" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="Slider_ValueChanged"/>
          <Slider x:Name="SliderB" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="Slider_ValueChanged"/>
          <DockPanel Margin="0,4,0,0">
            <TextBlock Text="A" VerticalAlignment="Center" Width="14"/>
            <Slider x:Name="SliderA" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>
          </DockPanel>
          <Button Content="OK" HorizontalAlignment="Right" Width="64" Height="24" Margin="0,8,0,0"
                  Click="PickerOk_Click"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
